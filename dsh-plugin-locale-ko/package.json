{
  "name": "dsh-plugin-locale-ko",
  "version": "0.2.0",
  "description": "Unofficial Korean UI language pack for DeepSeek Harness (DSH)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjoni12/dsh-locale-ko.git"
  }
}
